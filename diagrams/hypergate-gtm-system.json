  "nodes": {
    "1A": {
      "kind": "start",
      "title": "Context OS",
      "sub": "ICP, personas, signal matrix, messaging, playbooks",
      "tools": [
        "claude_code",
        "github"
      ],
      "w": 300
    },
    "1B": {
      "kind": "step",
      "title": "Buying signals",
      "sub": [
        "W1 Acronis Files EOL",
        "W2 NTLM on mobile",
        "W3 EMM migration",
        "W4 Frontline rollout",
        "W5 Android Enterprise",
        "W6 Sovereignty",
        "W7 Lookalikes"
      ],
      "tools": [
        "clay"
      ]
    },
    "1C": {
      "kind": "step",
      "title": "Find companies",
      "sub": "One row per domain, one workbook per signal",
      "tools": [
        "clay"
      ]
    },
    "1D": {
      "kind": "decision",
      "title": "Known account?"
    },
    "supp": {
      "kind": "exit",
      "title": "Suppress, or attach signal to existing row",
      "below": "1D",
      "w": 240
    },
    "1E": {
      "kind": "step",
      "title": "Enrich",
      "sub": [
        "AD evidence",
        "EMM in use",
        "Device and OS clues",
        "Second signal",
        "Partner region"
      ],
      "tools": [
        "clay",
        "claude"
      ]
    },
    "1F": {
      "kind": "decision",
      "title": "ICP fit?"
    },
    "fail": {
      "kind": "exit",
      "title": "Fail: keep reason, never send",
      "below": "1F",
      "w": 240
    },
    "1G": {
      "kind": "branch",
      "title": "Pass",
      "sub": "On-prem AD and supported EMM known",
      "w": 260
    },
    "1H": {
      "kind": "branch",
      "title": "Pass-provisional",
      "sub": "Unknown, but Ready-now signal: first email confirms fit",
      "w": 260
    },
    "hold": {
      "kind": "exit",
      "title": "Hold: re-check on a new signal",
      "w": 260
    },
    "2A": {
      "kind": "step",
      "title": "Route by segment",
      "sub": [
        "Trigger: highest tier wins",
        "Proof: police York, bank Jefferies, shift work Maersk",
        "Owner: direct or partner (open)",
        "Language: EN, DE, FR, IT"
      ],
      "tools": [
        "clay"
      ],
      "w": 300
    },
    "2B": {
      "kind": "step",
      "title": "Find people",
      "sub": "Up to 3: champion, influencer, economic buyer test",
      "tools": [
        "clay"
      ]
    },
    "2C": {
      "kind": "decision",
      "title": "Contact found?"
    },
    "nocontact": {
      "kind": "exit",
      "title": "Back to Hold",
      "below": "2C"
    },
    "2D": {
      "kind": "decision",
      "title": "In CRM?"
    },
    "incrm": {
      "kind": "exit",
      "title": "Follow CRM status",
      "below": "2D"
    },
    "2E": {
      "kind": "step",
      "title": "Find and verify email",
      "sub": "Waterfall, LeadMagic, then BounceBan",
      "tools": [
        "clay",
        "LeadMagic",
        "BounceBan"
      ]
    },
    "2F": {
      "kind": "decision",
      "title": "Email valid?"
    },
    "li": {
      "kind": "exit",
      "title": "LinkedIn-only track",
      "below": "2F"
    },
    "2G": {
      "kind": "decision",
      "title": "Country rules?"
    },
    "2H": {
      "kind": "branch",
      "title": "Opt-in only",
      "sub": "DE, AT, IT, rest of EU: no cold email, LinkedIn without pitch, partners",
      "w": 280
    },
    "2I": {
      "kind": "branch",
      "title": "Email allowed",
      "sub": "FR, UK, US, CA; CH pending legal",
      "w": 280
    },
    "3A": {
      "kind": "step",
      "title": "Sequence",
      "sub": [
        "Day 1 email",
        "Day 2 connect, no pitch",
        "Day 4 email with proof",
        "Day 7 DM",
        "Day 10 email"
      ],
      "tools": [
        "Sequencer (open)",
        "Sales Navigator"
      ],
      "w": 300,
      "tool_label": "Sequencer + LinkedIn: open"
    },
    "3B": {
      "kind": "decision",
      "title": "Any reply?"
    },
    "noreply": {
      "kind": "exit",
      "title": "No response: suppress for window",
      "below": "3B",
      "w": 240
    },
    "3C": {
      "kind": "step",
      "title": "Classify reply",
      "sub": "Same business day, a person sends every reply",
      "tools": [
        "claude"
      ]
    },
    "o1": {
      "kind": "branch",
      "title": "Positive or meeting",
      "h": 80

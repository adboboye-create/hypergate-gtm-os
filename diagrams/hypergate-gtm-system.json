    },
    "o4": {
      "kind": "branch",
      "title": "Wrong person",
      "h": 80
    },
    "o5": {
      "kind": "branch",
      "title": "Not a fit or unsubscribe",
      "h": 80
    },
    "a1": {
      "kind": "step",
      "title": "Book meeting, hand to owner",
      "w": 300,
      "h": 80
    },
    "a2": {
      "kind": "step",
      "title": "Add contact, warm thread",
      "w": 300,
      "h": 80
    },
    "a3": {
      "kind": "step",
      "title": "Answer or set follow-up",
      "w": 300,
      "h": 80
    },
    "a4": {
      "kind": "exit",
      "title": "Find the owner, back to 2B",
      "w": 300,
      "h": 80
    },
    "a5": {
      "kind": "exit",
      "title": "Disqualify or suppress everywhere",
      "w": 300,
      "h": 80
    },
    "3D": {
      "kind": "step",
      "title": "CRM",
      "sub": "Account, contact, signal, activity, deal",
      "tools": [
        "Zoho CRM"
      ]
    },
